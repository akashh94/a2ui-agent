# a2ui-agent — environment variable reference.
# The project is split into two services; each has its own env file:
#   a2ui-server/a2ui.deploy.env    (+ deploy.personal.env for personal)
#   a2ui-agent/a2ui.deploy.env     (+ deploy.personal.env for personal)
# These are sourced by the build/deploy scripts in each directory.
# This root example documents the shared variables.

# --- Model (a2ui-agent) -----------------------------------------------------
# The model the agent uses.
AGENT_MODEL=gemini-2.5-flash

# Vertex AI model location. Regional endpoint (e.g. us-central1); "global"
# was not reachable for this project's models.
MODEL_LOCATION=us-central1

# --- a2ui-server ------------------------------------------------------------
# Comma-separated CORS origins. "*" allows any origin (public demo).
ALLOW_ORIGINS=*

# Canonical /etcatalog URL the catalog's $id / catalogId point at.
# In local dev this is localhost; on Cloud Run set it to the deployed URL.
CATALOG_URL=http://localhost:8000/etcatalog

# The deployed Agent Engine the /chat proxy calls.
AGENT_ENGINE_PROJECT=your-project-id
AGENT_ENGINE_LOCATION=us-central1
AGENT_ENGINE_ID=your-reasoning-engine-id

# Authentication is via Application Default Credentials (ADC) — the Cloud Run /
# Agent Engine service account in production, `gcloud auth application-default
# login` locally. No API keys needed.
