# a2ui-agent — environment variable reference.
# The single service lives in a2ui-agent/; its deploy env files
# (a2ui.deploy.env, deploy.personal.env) are sourced by its build/deploy
# scripts. This root example documents the shared variables.

# The model the agent uses.
AGENT_MODEL=gemini-2.5-flash

# Vertex AI model location. Regional endpoint (e.g. us-central1); "global"
# was not reachable for this project's models.
MODEL_LOCATION=us-central1

# Comma-separated origins allowed to call this agent's A2A/catalog endpoints
# cross-origin. The separately-deployed a2ui-client's origin must be listed.
# "*" allows any origin (public demo).
ALLOW_ORIGINS=*

# Authentication is via Application Default Credentials (ADC) — the Cloud Run
# service account in production, `gcloud auth application-default login`
# locally. No API keys needed.
