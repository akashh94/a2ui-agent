# a2ui-agent service deployment config — office environment.
# Sourced by build.sh and deploy.sh in this directory.
# The personal equivalents live in deploy.personal.env (sourced by
# build.personal.sh and deploy.personal.sh). Picking which file you source
# is what picks which environment you deploy to.
#
# All values use "${VAR:-default}" so you can override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- Artifact Registry ------------------------------------------------------
export ARTIFACT_REGISTRY="${ARTIFACT_REGISTRY:-a2ui-agent}"
export ARTIFACT_REGION="${ARTIFACT_REGION:-${REGION}}"

# --- Cloud Run service --------------------------------------------------------
export SERVICE_NAME="${SERVICE_NAME:-a2ui-agent}"
# Set after first deploy to the printed service URL (project hash varies).
export APP_URL="${APP_URL:-https://a2ui-agent-492310803820.${REGION}.run.app}"

# --- Model -----------------------------------------------------------------
export AGENT_MODEL="${AGENT_MODEL:-gemini-2.5-flash}"
export MODEL_LOCATION="${MODEL_LOCATION:-${REGION}}"
