# a2ui-agent a2ui-server deployment config — office environment.
# Sourced by build.sh and deploy.sh in this directory.
# The personal equivalents live in deploy.personal.env (sourced by
# build.personal.sh and deploy.personal.sh). Picking which file you source
# is what picks which environment you deploy to.
#
# All values use "${VAR:-default}" so you can override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- Container image --------------------------------------------------------
export SERVICE_NAME="${SERVICE_NAME:-a2ui-server}"
export PROJECT_ID_HASH="${PROJECT_ID_HASH:-000000000000}"
export IMAGE="${IMAGE:-gcr.io/${PROJECT_ID}/a2ui-server}"

# --- Agent Engine (the deployed agent this service proxies to) ---------------
# Set after you deploy the a2ui-agent to Agent Engine.
export AGENT_ENGINE_PROJECT="${AGENT_ENGINE_PROJECT:-${PROJECT_ID}}"
export AGENT_ENGINE_LOCATION="${AGENT_ENGINE_LOCATION:-${REGION}}"
export AGENT_ENGINE_ID="${AGENT_ENGINE_ID:-REPLACE}"

# --- Service account ----------------------------------------------------------
# The Cloud Run service runs as this SA; ADC gives it access to call the
# Agent Engine (needs roles/aiplatform.user on the project).
export SERVICE_ACCOUNT="${SERVICE_ACCOUNT:-vertex-express@${PROJECT_ID}.iam.gserviceaccount.com}"

# --- Runtime env vars -------------------------------------------------------
# CORS origins (comma-separated; "*" = any origin, public demo).
export ALLOW_ORIGINS="${ALLOW_ORIGINS:-*}"
# Canonical /etcatalog URL the catalog's $id / catalogId point at.
# After first deploy, set to: https://${SERVICE_NAME}-${PROJECT_ID_HASH}.${REGION}.run.app/etcatalog
export CATALOG_URL="${CATALOG_URL:-http://localhost:8000/etcatalog}"
