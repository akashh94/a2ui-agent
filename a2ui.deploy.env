# a2ui-agent deployment config — office environment.
# Sourced by build.sh and deploy.sh in this directory.
# The personal equivalents live in deploy.personal.env (sourced by
# build.personal.sh and deploy.personal.sh). Picking which file you source
# is what picks which environment you deploy to.
#
# All values use "${VAR:-default}" so you can override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- Container image --------------------------------------------------------
export SERVICE_NAME="${SERVICE_NAME:-a2ui-agent}"
# PROJECT_ID_HASH is the short hash gcloud appends to the service URL. After
# the first deploy, set it to the actual hash from the printed URL.
export PROJECT_ID_HASH="${PROJECT_ID_HASH:-000000000000}"
export IMAGE="${IMAGE:-gcr.io/${PROJECT_ID}/a2ui-agent}"

# --- Model -----------------------------------------------------------------
# Matches .env.example's AGENT_MODEL default.
export AGENT_MODEL="${AGENT_MODEL:-gemini-2.0-flash}"
# Vertex AI model location. "global" spreads load across regions.
export MODEL_LOCATION="${MODEL_LOCATION:-global}"

# --- Service account ----------------------------------------------------------
# The Cloud Run service runs as this SA; ADC gives it Vertex AI access.
# It needs roles/aiplatform.user (Vertex AI User) on the project.
export SERVICE_ACCOUNT="${SERVICE_ACCOUNT:-vertex-express@${PROJECT_ID}.iam.gserviceaccount.com}"

# --- Runtime env vars -------------------------------------------------------
# CORS origins (comma-separated; "*" = any origin, public demo).
export ALLOW_ORIGINS="${ALLOW_ORIGINS:-*}"
